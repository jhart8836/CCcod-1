<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60%p" android:startColor="#553FBFAE" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#22111926" />
            <stroke android:width="1.5dp" android:color="#CC6FD8E8" />
        </shape>
    </item>
</layer-list>
