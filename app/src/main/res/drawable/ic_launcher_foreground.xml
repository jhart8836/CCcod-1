<?xml version="1.0" encoding="utf-8"?>
<!-- ANCHOR ONE mark: a still point at the centre of an orbit. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- soft halo -->
    <path android:pathData="M54,30a24,24 0 1,1 0,48a24,24 0 1,1 0,-48z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="26">
                <item android:offset="0" android:color="#3358C9DD" />
                <item android:offset="1" android:color="#0058C9DD" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- orbit ring -->
    <path android:pathData="M54,32a22,22 0 1,1 0,44a22,22 0 1,1 0,-44z"
        android:strokeColor="#99B9C5D3" android:strokeWidth="1.6" android:fillColor="#00000000" />
    <!-- lit arc -->
    <path android:pathData="M65,34.95A22,22 0 0,1 73.05,65"
        android:strokeColor="#FF6FD8E8" android:strokeWidth="2.6" android:strokeLineCap="round" android:fillColor="#00000000" />
    <!-- orbiting light -->
    <path android:pathData="M73.05,61.4a3.6,3.6 0 1,1 0,7.2a3.6,3.6 0 1,1 0,-7.2z" android:fillColor="#FFE6F9FC" />
    <!-- still point -->
    <path android:pathData="M54,47a7,7 0 1,1 0,14a7,7 0 1,1 0,-14z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="52" android:centerY="51" android:gradientRadius="9">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FF6FD8E8" />
                <item android:offset="1" android:color="#FF3FBFAE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
